%% What was added to test replay (2026-10-20). Green: new. Grey: already there.
%% Shapes: [rectangle] code, [/parallelogram/] file, [(cylinder)] data in memory.
flowchart TB
    classDef new fill:#d9f2d9,stroke:#2e7d32,stroke-width:2px,color:#1b3d1b
    classDef old fill:#f2f2f2,stroke:#9e9e9e,color:#444
    classDef ext fill:#e3ecfa,stroke:#3d6cb9,stroke-width:2px,color:#1a2f55
    classDef bug fill:#ffe0e0,stroke:#c62828,stroke-width:2px,color:#5a0000

    %% ------------------------------------------------------------ part 1
    subgraph P1["1 · лог replay и тесты алгоритма"]
        direction TB
        T_PROF[/"маленький profile из теста<br/>ответ известен заранее"/]:::old
        subgraph RP["replay/qmem-replay"]
            direction LR
            SCHED["replay.c — scheduler<br/>+ log_event, log_epoch, log_drop<br/>+ остаток переносится между эпохами"]:::new
            EXEC["exec.c — executor<br/>+ log_tick<br/>+ допуск при округлении"]:::new
            MEM["memory.c<br/>+ log_touch: w · r · skip"]:::new
            LOGC["log.c — новый<br/>записи в памяти → файл в конце"]:::new
            SCHED --> EXEC --> MEM
            SCHED & EXEC & MEM --> LOGC
        end
        RLOG[/"run.log — docs/formats/replay_log.md<br/>start · region · event · epoch · drop · tick · touch · end"/]:::new
        T_LOG["tests/test_replay_log.py — 7<br/>строки и уровни лога"]:::new
        T_ALG["tests/test_replay_algorithm.py — 13<br/>события в свой тик · границы эпох · число касаний<br/>roundrobin / random · доля записи · unmap · бросание работы"]:::new
        T_PROF -->|--log --log-level| RP
        LOGC --> RLOG
        RLOG --> T_LOG & T_ALG
    end

    BUG1["ошибка 1: терялось последнее касание эпохи → исправлено"]:::bug
    BUG2["ошибка 2: на коротких эпохах касаний не было → исправлено"]:::bug
    T_ALG -.-> BUG1

    %% ------------------------------------------------------------ part 2
    subgraph P2["2 · сравнение с damoLoad — tools/damoload_check.py"]
        direction TB
        CFG[/"конфиг memtest<br/>third_party/damoLoad/memtest/configs/*.json<br/>обрезается: --duration"/]:::ext
        subgraph LEFT["эталон"]
            MT["memtest (damoLoad, submodule 83763e9)<br/>--auto, старт по SIGUSR1"]:::ext
            GT[/"gt.log<br/>время_нс регион страница"/]:::ext
        end
        subgraph RIGHT["проверяемое"]
            M2P["tools/memtest2profile.py — новый<br/>частота страницы = Σ hz(t) × P(страницы)<br/>эпохи 10 мс, одинаковые склеены"]:::new
            PROF[/"profile.txt"/]:::new
            QR["qmem-replay --log-level touches"]:::new
            RL[/"replay.log"/]:::new
        end
        CNT[("count: регион × окно 100 мс × страница")]:::new
        CMP["compare<br/>окна: |r − m| ≤ 4√m + 2<br/>страницы: TV ≤ 0.05 + шум<br/>всего: ≤ 2% + шум"]:::new
        OUT[/"comparison.txt · report.json · summary.txt<br/>код выхода 0 / 1"/]:::new
        CFG --> MT --> GT --> CNT
        CFG --> M2P --> PROF --> QR --> RL --> CNT
        CNT --> CMP --> OUT
    end

    T_M2P["tests/test_memtest2profile.py — 16<br/>частоты всех spatial / temporal · все 101 конфиг"]:::new
    T_DL["tests/test_damoload.py — 15<br/>6 конфигов по 3 с совпадают · неверный replay ловится"]:::new
    FULL["make damoload-check — все 101 конфиг, ~40 мин<br/>94 совпали"]:::new
    REP[/"docs/replay_testing_report.md<br/>examples/damoload_run/ — файлы одного прогона"/]:::new
    BUG3["ошибка 3: опоздавшие тики догоняются → предложено исправление"]:::bug
    MTQ["особенности memtest: обнуление работы после паузы,<br/>опоздание при скачке частоты → решить: а) повторить в конвертере / б) пометить"]:::ext

    M2P -.- T_M2P
    OUT --> T_DL
    OUT --> FULL --> REP
    CMP -.-> BUG2
    FULL -.-> BUG3
    FULL -.-> MTQ
    QR -.->|тот же replay| RP
