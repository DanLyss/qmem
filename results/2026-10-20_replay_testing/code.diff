diff --git a/tests/test_damoload.py b/tests/test_damoload.py
new file mode 100644
index 0000000..b4b1733
--- /dev/null
+++ b/tests/test_damoload.py
@@ -0,0 +1,137 @@
+"""tools/damoload_check.py: damoLoad's memtest (taken as correct) and
+qmem-replay on the same workload, compared touch by touch. See
+docs/replay_testing.md, section 2.3."""
+import json
+import subprocess
+import sys
+
+import pytest
+
+from conftest import ROOT
+
+sys.path.insert(0, str(ROOT / 'tools'))
+import damoload_check as dc  # noqa: E402
+
+CHECK = ROOT / 'tools' / 'damoload_check.py'
+CONFIGS = ROOT / 'third_party' / 'damoLoad' / 'memtest' / 'configs'
+needs_damoload = pytest.mark.skipif(not CONFIGS.is_dir(),
+                                    reason='damoLoad submodule not checked out')
+MS = 1_000_000
+
+
+# ---------------------------------------------------------------- logs
+
+
+def test_read_gt(tmp_path):
+    p = tmp_path / 'gt.log'
+    p.write_text('# region 0 base=0x7f0000000000 pages=10\n# region 1 base=0x7f1000000000 pages=3\n'
+                 '# ts_ns region page\n1000 0 3\n2000 1 2\n')
+    regions, touches = dc.read_gt(p)
+    assert regions == [10, 3]
+    assert touches == [(1000, 0, 3), (2000, 1, 2)]
+
+
+def test_read_replay_log(tmp_path):
+    p = tmp_path / 'run.log'
+    p.write_text('start seed=1 regions=1 events=1 epochs=1 end_ms=10 level=touches\n'
+                 'region id=0 pages=4 base=0x7f0000000000\n'
+                 'touch t_ns=5 region=0 page=1 op=w\ntouch t_ns=6 region=0 page=2 op=skip\n'
+                 'touch t_ns=7 region=0 page=3 op=r\nend planned=3 done=2 skipped=1 populated=0 '
+                 'lagged_ticks=0\n')
+    touches, end = dc.read_replay_log(p)
+    assert touches == [(5, 0, 1), (7, 0, 3)]            # skipped touches touched nothing
+    assert end['lagged_ticks'] == '0'
+
+
+# ---------------------------------------------------------------- comparison
+
+
+def counts(touches, duration=1.0):
+    return dc.count(touches, t0=0, duration=duration, window_ms=100)
+
+
+def uniform(n_per_page_window, pages=10, windows=10, region=0, jitter=0):
+    out = []
+    for w in range(windows):
+        for p in range(pages):
+            for k in range(n_per_page_window + (jitter if (w + p) % 2 else 0)):
+                out.append(((w * 100 + 1 + k % 90) * MS, region, p))
+    return out
+
+
+def test_same_touches_match():
+    t = uniform(20)
+    r = dc.compare(counts(t), counts(t))
+    assert r['ok'], r
+
+
+def test_noise_within_poisson_matches():
+    r = dc.compare(counts(uniform(20)), counts(uniform(20, jitter=1)))
+    assert r['ok'], r
+
+
+def test_window_total_off_is_caught():
+    ref = uniform(20)
+    got = [x for x in ref if not (300 * MS <= x[0] < 400 * MS)]       # one window empty
+    r = dc.compare(counts(ref), counts(got))
+    assert not r['ok']
+    assert [(b['region'], b['window']) for b in r['bad_windows']] == [(0, 3)]
+
+
+def test_page_distribution_off_is_caught():
+    ref = uniform(20)
+    got = [(t, r, 0 if p < 5 else p) for t, r, p in ref]              # pages 1-4 moved to 0
+    r = dc.compare(counts(ref), counts(got))
+    assert not r['ok']
+    assert r['regions'][0]['tv'] > r['regions'][0]['tv_limit']
+    assert not r['bad_windows']                                        # totals still agree
+
+
+def test_total_off_is_caught():
+    r = dc.compare(counts(uniform(200)), counts(uniform(180)))
+    assert not r['ok']
+    assert abs(r['total_rel'] + 0.1) < 1e-9
+
+
+def test_touches_outside_the_run_are_dropped():
+    c = counts([(-5 * MS, 0, 0), (50 * MS, 0, 1), (1000 * MS, 0, 2)], duration=1.0)
+    assert c['total'] == 1
+
+
+# ---------------------------------------------------------------- end to end
+
+
+def run_check(tmp_path, cfg, *args):
+    out = tmp_path / 'report.json'
+    p = subprocess.run([sys.executable, str(CHECK), str(CONFIGS / cfg), '--duration', '3',
+                        '--json', str(out), '--keep', str(tmp_path / 'work')] + list(args),
+                       capture_output=True, text=True, timeout=300)
+    report = json.loads(out.read_text())[0] if out.exists() else None
+    return p, report
+
+
+@needs_damoload
+@pytest.mark.parametrize('cfg', [
+    '05_ten_pages_sequential.json',       # sequential, const
+    '06_all_pages_simultaneously.json',   # all
+    '08_hotspot_two_pages.json',          # hotspot
+    '23_two_tracks_same_region.json',     # two tracks on one region
+    '36_three_regions.json',              # 3 regions; uniform, hotspot, zipf; sine, square
+    '48_three_regions_complex.json',      # all, gaussian, hotspot; ramp, sine, square
+])
+def test_replay_matches_memtest(tmp_path, cfg):
+    p, report = run_check(tmp_path, cfg)
+    assert p.returncode == 0, p.stdout + p.stderr
+    assert report['ok'], json.dumps(report, indent=1)[:3000]
+    assert report['total_ref'] > 0
+    assert (tmp_path / 'work' / 'gt.log').exists()
+    assert (tmp_path / 'work' / 'replay.log').exists()
+
+
+@needs_damoload
+def test_a_wrong_replay_is_caught(tmp_path):
+    """The check is not blind: replaying 30 % slower must fail."""
+    p, report = run_check(tmp_path, '04_ten_pages_uniform.json', '--scale-rate', '0.7')
+    assert p.returncode == 1, p.stdout + p.stderr
+    assert not report['ok']
+    assert report['total_rel'] < -0.2
diff --git a/tests/test_memtest2profile.py b/tests/test_memtest2profile.py
new file mode 100644
index 0000000..d843dc6
--- /dev/null
+++ b/tests/test_memtest2profile.py
@@ -0,0 +1,222 @@
+"""tools/memtest2profile.py: a damoLoad memtest config -> profile v2 with
+the same expected touches per page per second. See docs/replay_testing.md,
+section 2.2."""
+import json
+import math
+import subprocess
+import sys
+
+import pytest
+
+from conftest import ROOT
+
+sys.path.insert(0, str(ROOT / 'builder'))
+import profile_v2  # noqa: E402
+
+M2P = ROOT / 'tools' / 'memtest2profile.py'
+CONFIGS = ROOT / 'third_party' / 'damoLoad' / 'memtest' / 'configs'
+PAGE = 4096
+
+
+def convert(tmp_path, cfg, *args):
+    path = tmp_path / 'cfg.json'
+    path.write_text(json.dumps(cfg))
+    out = tmp_path / 'p.txt'
+    p = subprocess.run([sys.executable, str(M2P), str(path), '-o', str(out)] + list(args),
+                       capture_output=True, text=True, timeout=120)
+    assert p.returncode == 0, p.stderr
+    return profile_v2.read(out)
+
+
+def config(tracks, regions=(10,), duration=2):
+    return {'duration_sec': duration, 'regions': [{'pages': n} for n in regions],
+            'tracks': tracks}
+
+
+def track(spatial, temporal, region=0, **kw):
+    return dict(region=region, spatial=spatial, temporal=temporal, **kw)
+
+
+def rates(prof):
+    """{(epoch t, dur): {(region, page): rate per page}} and the patterns."""
+    out, patterns = {}, set()
+    for ep in prof.epochs:
+        r = out.setdefault((ep.t, ep.dur), {})
+        for a in ep.accesses:
+            assert a.off % PAGE == 0 and a.len % PAGE == 0
+            for p in range(a.off // PAGE, (a.off + a.len) // PAGE):
+                r[(a.region, p)] = r.get((a.region, p), 0) + a.rate
+            patterns.add((a.region, a.pattern))
+            assert a.write == 1
+    return out, patterns
+
+
+def only_epoch(prof):
+    r, _ = rates(prof)
+    assert len(r) == 1, sorted(r)
+    return next(iter(r.items()))
+
+
+def close(a, b, rel=1e-4):
+    return abs(a - b) <= rel * max(abs(b), 1e-9)
+
+
+# ---------------------------------------------------------------- memory
+
+
+def test_regions_are_mapped_and_populated_at_zero(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {'type': 'const', 'hz': 10})],
+                                     regions=(10, 3)))
+    assert [(r.id, r.size, r.kind) for r in prof.regions] == [(0, 10 * PAGE, 'anon'),
+                                                              (1, 3 * PAGE, 'anon')]
+    ev = sorted((e.kind, e.t, e.region, e.off, e.len) for e in prof.events)
+    assert ev == [('map', 0, 0, 0, 10 * PAGE), ('map', 0, 1, 0, 3 * PAGE),
+                  ('populate', 0, 0, 0, 10 * PAGE), ('populate', 0, 1, 0, 3 * PAGE)]
+
+
+# ---------------------------------------------------------------- spatial
+
+
+def test_uniform(tmp_path):
+    (t, dur), r = only_epoch(convert(tmp_path, config(
+        [track({'type': 'uniform'}, {'type': 'const', 'hz': 100})])))
+    assert (t, dur) == (0, 2000)
+    assert r == {(0, p): 10.0 for p in range(10)}
+    _, patterns = rates(convert(tmp_path, config(
+        [track({'type': 'uniform'}, {'type': 'const', 'hz': 100})])))
+    assert patterns == {(0, 'random')}
+
+
+def test_sequential_and_all_walk_round_robin(tmp_path):
+    prof = convert(tmp_path, config([
+        track({'type': 'sequential'}, {'type': 'const', 'hz': 100}, region=0),
+        track({'type': 'all'}, {'type': 'const', 'hz': 7}, region=1)], regions=(10, 4)))
+    (_, _), r = only_epoch(prof)
+    assert r == {**{(0, p): 10.0 for p in range(10)}, **{(1, p): 7.0 for p in range(4)}}
+    assert rates(prof)[1] == {(0, 'roundrobin'), (1, 'roundrobin')}
+
+
+def test_hotspot(tmp_path):
+    prof = convert(tmp_path, config([track(
+        {'type': 'hotspot', 'hot_pages': [0, 1], 'hot_ratio': 0.9},
+        {'type': 'const', 'hz': 100})]))
+    (_, _), r = only_epoch(prof)
+    assert all(close(r[(0, p)], 45.0) for p in (0, 1))
+    assert all(close(r[(0, p)], 100 * 0.1 / 8) for p in range(2, 10))
+    # one line for the hot pages, one for the cold ones (the last cold page
+    # differs from the others only by rounding)
+    assert [(a.off // PAGE, a.len // PAGE) for a in prof.epochs[0].accesses] == [(0, 2), (2, 8)]
+
+
+def test_zipf(tmp_path):
+    (_, _), r = only_epoch(convert(tmp_path, config(
+        [track({'type': 'zipf', 's': 1.0}, {'type': 'const', 'hz': 100})], regions=(4,))))
+    h = sum(1 / k for k in range(1, 5))
+    for p in range(4):
+        assert close(r[(0, p)], 100 / (p + 1) / h), p
+
+
+def test_gaussian(tmp_path):
+    (_, _), r = only_epoch(convert(tmp_path, config(
+        [track({'type': 'gaussian', 'center': 5.0, 'sigma': 1.5}, {'type': 'const', 'hz': 100})])))
+
+    def cdf(x):
+        return 0.5 * (1 + math.erf((x - 5.0) / (1.5 * math.sqrt(2))))
+    for p in range(10):
+        lo = 0.0 if p == 0 else cdf(p - 0.5)
+        hi = 1.0 if p == 9 else cdf(p + 0.5)
+        assert close(r.get((0, p), 0), 100 * (hi - lo), rel=1e-3), p
+    assert close(sum(r.values()), 100)
+
+
+def test_unknown_spatial_is_uniform_like_memtest(tmp_path):
+    (_, _), r = only_epoch(convert(tmp_path, config(
+        [track({'type': 'mystery'}, {'type': 'const', 'hz': 50})], regions=(5,))))
+    assert r == {(0, p): 10.0 for p in range(5)}
+
+
+# ---------------------------------------------------------------- temporal
+
+
+def test_steps_merge_into_epochs(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {'type': 'steps', 'steps': [
+        {'hz': 50, 'duration_sec': 1}, {'hz': 200, 'duration_sec': 0.5}]})]))
+    r, _ = rates(prof)
+    # the last step holds after its end, as in memtest
+    assert r == {(0, 1000): {(0, p): 5.0 for p in range(10)},
+                 (1000, 1000): {(0, p): 20.0 for p in range(10)}}
+
+
+def test_square(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {
+        'type': 'square', 'on_hz': 200, 'duty': 0.3, 'period_sec': 1.0})]))
+    r, _ = rates(prof)
+    assert sorted(r) == [(0, 300), (1000, 300)]          # silent epochs left out
+    assert all(v == 20.0 for e in r.values() for v in e.values())
+
+
+def test_square_phase(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {
+        'type': 'square', 'on_hz': 200, 'duty': 0.5, 'period_sec': 1.0,
+        'phase_rad': math.pi / 2})]))
+    # a quarter period ahead: on in [0, 250) and [750, 1250) ...
+    assert sorted(rates(prof)[0]) == [(0, 250), (750, 500), (1750, 250)]
+
+
+def test_ramp_and_sine_follow_the_curve(tmp_path):
+    prof = convert(tmp_path, config([
+        track({'type': 'uniform'}, {'type': 'ramp', 'start_hz': 0, 'end_hz': 200}, region=0),
+        track({'type': 'uniform'}, {'type': 'sine', 'base_hz': 50, 'amplitude': 80,
+                                    'period_sec': 1.0}, region=1)], regions=(10, 10)),
+        '--epoch-ms', '10')
+    r, _ = rates(prof)
+    for (t, dur), pages in r.items():
+        mid = (t + dur / 2) / 1000
+        if (0, 0) in pages:
+            assert abs(pages[(0, 0)] * 10 - 200 * mid / 2) < 2
+        if (1, 0) in pages:
+            want = max(0.0, 50 + 80 * math.sin(2 * math.pi * mid))
+            assert abs(pages[(1, 0)] * 10 - want) < 8      # clamping inside an epoch
+    # sine below zero: silent stretches, no epochs for region 1 there
+    quiet = [t for (t, dur), p in r.items() if (1, 0) not in p]
+    assert quiet
+
+
+def test_track_window(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {'type': 'const', 'hz': 100},
+                                           start_sec=0.5, end_sec=1.25)]))
+    assert sorted(rates(prof)[0]) == [(500, 750)]
+
+
+def test_tracks_add_up(tmp_path):
+    (_, _), r = only_epoch(convert(tmp_path, config([
+        track({'type': 'uniform'}, {'type': 'const', 'hz': 100}),
+        track({'type': 'all'}, {'type': 'const', 'hz': 3})])))
+    assert r == {(0, p): 13.0 for p in range(10)}
+
+
+def test_duration_option_cuts_the_config(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {'type': 'const', 'hz': 100})],
+                                    duration=30), '--duration', '1.5')
+    assert sorted(rates(prof)[0]) == [(0, 1500)]
+
+
+def test_meta(tmp_path):
+    prof = convert(tmp_path, config([track({'type': 'uniform'}, {'type': 'const', 'hz': 1})]),
+                   '--epoch-ms', '20', '--seed', '5')
+    assert prof.meta['epoch_ms'] == '20' and prof.meta['seed'] == '5'
+    assert prof.meta['source'] == 'memtest:cfg'
+
+
+# ---------------------------------------------------------------- shipped configs
+
+
+@pytest.mark.skipif(not CONFIGS.is_dir(), reason='damoLoad submodule not checked out')
+def test_every_shipped_config_converts(tmp_path):
+    for cfg in sorted(CONFIGS.glob('*.json')):
+        out = tmp_path / (cfg.stem + '.txt')
+        p = subprocess.run([sys.executable, str(M2P), str(cfg), '-o', str(out),
+                            '--duration', '1'], capture_output=True, text=True, timeout=300)
+        assert p.returncode == 0, (cfg.name, p.stderr)
+        prof = profile_v2.read(out)
+        assert len(prof.regions) == len(json.loads(cfg.read_text())['regions']), cfg.name
diff --git a/tests/test_replay_algorithm.py b/tests/test_replay_algorithm.py
new file mode 100644
index 0000000..3fdf1eb
--- /dev/null
+++ b/tests/test_replay_algorithm.py
@@ -0,0 +1,261 @@
+"""The replay algorithm step by step, checked through its log (--log): events
+at their tick, epoch boundaries, how many touches and which pages, the write
+share, unmapped pages, dropped work. Nothing here is about how close a
+replay is to an original. See docs/replay_testing.md, section 1.2."""
+from collections import Counter, defaultdict
+
+from test_replay import MB, PAGE, access, epochs, ev, region, run_replay, write_profile
+from test_replay_log import lines, parse_log, run_logged
+
+MS = 1_000_000
+
+
+def touches(log):
+    return [(int(t['t_ns']), int(t['region']), int(t['page']), t['op'])
+            for t in lines(log, 'touch')]
+
+
+def ticks(log):
+    return [{k: (float(v) if k == 'carry' else int(v)) for k, v in t.items()}
+            for t in lines(log, 'tick')]
+
+
+# ---------------------------------------------------------------- events
+
+
+def test_events_at_their_tick_in_order(tmp_path):
+    body = [region(0, MB), region(1, MB),
+            ev('map', 0, 0, 0, MB), ev('map', 0, 1, 0, MB // 2),
+            ev('unmap', 137, 0, 0, MB // 2), ev('map', 250, 0, 0, MB // 2),
+            ev('unmap', 400, 1, 0, MB // 2)]
+    log, _ = run_logged(tmp_path, body)
+    got = [(e['kind'], int(e['t']), int(e['tick']), int(e['region'])) for e in lines(log, 'event')]
+    assert got == [('map', 0, 0, 0), ('map', 0, 0, 1), ('unmap', 137, 137, 0),
+                   ('map', 250, 250, 0), ('unmap', 400, 400, 1)]
+
+
+def test_no_touch_lands_before_its_map(tmp_path):
+    pages = 64
+    body = [region(0, pages * PAGE), ev('map', 50, 0, 0, pages * PAGE)] + \
+        epochs(0, 200, 100, [access(0, 0, pages * PAGE, 50, write=0)])
+    log, _ = run_logged(tmp_path, body, 'touches')
+    tt = touches(log)
+    assert all(op == 'skip' for t, _, _, op in tt if t < 50 * MS)
+    mapped = [x for x in tt if x[0] >= 50 * MS]
+    assert mapped and all(op != 'skip' for *_, op in mapped)
+    # the first touch of every page after its map writes (a read would map
+    # the shared zero page)
+    first = {}
+    for _, _, p, op in mapped:
+        first.setdefault(p, op)
+    assert set(first.values()) == {'w'}
+
+
+def test_populate_writes_mapped_untouched_pages_once(tmp_path):
+    pages = 256
+    size = pages * PAGE
+    body = [region(0, size), ev('map', 0, 0, 0, size // 2),
+            ev('populate', 10, 0, 0, size),                 # only the mapped half
+            ev('populate', 20, 0, 0, size),                 # nothing left to write
+            ev('map', 30, 0, size // 2, size // 2),
+            ev('populate', 40, 0, 0, size),                 # the newly mapped half
+            ev('unmap', 50, 0, 0, size), ev('map', 60, 0, 0, size),
+            ev('populate', 70, 0, 0, size)]                 # everything again
+    log, _ = run_logged(tmp_path, body)
+    pop = [int(e['pages']) for e in lines(log, 'event', kind='populate')]
+    assert pop == [pages // 2, 0, pages // 2, pages]
+
+
+# ---------------------------------------------------------------- epochs
+
+
+def test_touches_stay_inside_epochs(tmp_path):
+    pages = 64
+    acc = [access(0, 0, pages * PAGE, 100)]
+    body = [region(0, pages * PAGE), ev('map', 0, 0, 0, pages * PAGE)] + \
+        ['epoch t=0 dur=50'] + acc + ['epoch t=100 dur=100'] + acc + ['epoch t=300 dur=20'] + acc
+    log, _ = run_logged(tmp_path, body, 'touches')
+    active = [range(0, 50), range(100, 200), range(300, 320)]
+    tk = [t['tick'] for t in ticks(log)]
+    assert tk and all(any(x in r for r in active) for x in tk)
+    for t, *_ in touches(log):
+        ms = t / MS
+        assert any(r.start <= ms < r.stop + 2 for r in active), ms
+    starts = [(int(e['idx']), int(e['tick'])) for e in lines(log, 'epoch', what='start')]
+    ends = [(int(e['idx']), int(e['tick'])) for e in lines(log, 'epoch', what='end')]
+    assert starts == [(0, 0), (1, 100), (2, 300)]
+    assert ends == [(0, 50), (1, 200), (2, 320)]
+
+
+def test_touch_count_and_carry(tmp_path):
+    """256 pages at 5.859375 touches per page per second: 1500 per second, so
+    1.5 touches per 1 ms tick: n alternates 1 and 2 through the carry."""
+    pages = 256
+    body = [region(0, pages * PAGE), ev('map', 0, 0, 0, pages * PAGE)] + \
+        epochs(0, 300, 100, [access(0, 0, pages * PAGE, 5.859375)])
+    log, _ = run_logged(tmp_path, body, 'ticks')
+    by_epoch = defaultdict(list)
+    for t in ticks(log):
+        by_epoch[t['epoch']].append(t)
+    assert sorted(by_epoch) == [0, 1, 2]
+    for e, tt in by_epoch.items():
+        assert len(tt) == 100                         # every tick has work
+        assert sum(t['n'] for t in tt) == 150         # rate x pages x dur
+        carry = 0.0                                   # 150 per epoch: nothing left over
+        for t in tt:
+            want = carry + 1.5
+            assert t['n'] == int(want)
+            assert abs(t['carry'] - (want - int(want))) < 1e-3
+            assert t['done'] == t['n']
+            carry = t['carry']
+    for e in lines(log, 'epoch', what='end'):
+        assert e['planned'] == e['done'] == '150'
+
+
+def test_slow_access_over_short_epochs_is_not_lost(tmp_path):
+    """40 touches per second over 100 epochs of 10 ms: 0.4 touches per epoch.
+    The fraction left at the end of an epoch goes on into the same range's
+    next epoch; resetting it lost every touch (found against damoLoad)."""
+    body = [region(0, PAGE), ev('map', 0, 0, 0, PAGE)] + \
+        epochs(0, 1000, 10, [access(0, 0, PAGE, 40)], dur=10)
+    log, _ = run_logged(tmp_path, body, 'ticks', epoch_ms=10)
+    total = sum(t['done'] for t in ticks(log))
+    assert abs(total - 40) <= 1
+
+
+def test_several_accesses_in_an_epoch(tmp_path):
+    size = 4 * MB
+    a, b = (0, 64 * PAGE), (512 * PAGE, 64 * PAGE)
+    body = [region(0, size), ev('map', 0, 0, 0, size)] + \
+        epochs(0, 200, 100, [access(0, a[0], a[1], 10), access(0, b[0], b[1], 30)])
+    log, _ = run_logged(tmp_path, body, 'touches')
+    sums = Counter()
+    for t in ticks(log):
+        sums[t['access']] += t['done']
+    assert sums == {0: 2 * 64, 1: 6 * 64}             # rate x pages x 0.2 s
+    pages = Counter('a' if p < 64 else 'b' if 512 <= p < 576 else '?'
+                    for _, _, p, _ in touches(log))
+    assert pages == {'a': 2 * 64, 'b': 6 * 64}
+
+
+# ---------------------------------------------------------------- generators
+
+
+def page_runs(log):
+    return [p for _, _, p, _ in touches(log)]
+
+
+def test_roundrobin_walks_in_a_circle_and_continues(tmp_path):
+    pages, off = 100, 7
+    body = [region(0, 128 * PAGE), ev('map', 0, 0, 0, 128 * PAGE)] + \
+        epochs(0, 300, 100, [access(0, off * PAGE, pages * PAGE, 13)])
+    log, _ = run_logged(tmp_path, body, 'touches')
+    seq = page_runs(log)
+    assert len(seq) == 3 * 130
+    assert all(off <= p < off + pages for p in seq)
+    # one circle across all three epochs: the next epoch goes on from the
+    # page after the last one
+    for x, y in zip(seq, seq[1:]):
+        assert y - off == (x - off + 1) % pages
+
+
+def start_pages(tmp_path, seed, name):
+    body = [region(0, 4 * MB), ev('map', 0, 0, 0, 4 * MB)] + \
+        epochs(0, 100, 100, [access(0, 0, 2 * MB, 5), access(0, 2 * MB, 2 * MB, 5)])
+    d = tmp_path / name
+    d.mkdir()
+    log, _ = run_logged(d, body, 'touches', seed=seed)
+    first = {}
+    for _, _, p, _ in touches(log):
+        first.setdefault(p >= 512, p)
+    return first[False], first[True]
+
+
+def test_roundrobin_start_depends_on_seed(tmp_path):
+    a, b, c = start_pages(tmp_path, 1, 'a'), start_pages(tmp_path, 1, 'b'), \
+        start_pages(tmp_path, 2, 'c')
+    assert a == b
+    assert a != c
+
+
+def test_random_pages_are_uniform_in_range(tmp_path):
+    pages, off = 64, 32
+    body = [region(0, 128 * PAGE), ev('map', 0, 0, 0, 128 * PAGE)] + \
+        epochs(0, 500, 100, [access(0, off * PAGE, pages * PAGE, 500, extra='pattern=random')])
+    log, _ = run_logged(tmp_path, body, 'touches')
+    seq = page_runs(log)
+    n = len(seq)
+    assert n == 500 * pages // 2
+    assert all(off <= p < off + pages for p in seq)
+    counts = Counter(seq)
+    expected = n / pages
+    chi2 = sum((counts[p] - expected) ** 2 / expected for p in range(off, off + pages))
+    assert chi2 < 150                                # 63 degrees of freedom
+    consecutive = sum(y == x + 1 for x, y in zip(seq, seq[1:]))
+    assert consecutive < n * 0.1                     # not a walk
+
+
+# ---------------------------------------------------------------- writes
+
+
+def test_write_share_is_a_fixed_set_of_pages(tmp_path):
+    pages = 1024
+    size = pages * PAGE
+    body = [region(0, size), ev('map', 0, 0, 0, size)] + \
+        epochs(0, 1000, 100, [access(0, 0, size, 20, write=0.25)])
+    log, _ = run_logged(tmp_path, body, 'touches')
+    ops = defaultdict(list)
+    for _, _, p, op in touches(log):
+        ops[p].append(op)
+    assert len(ops) == pages
+    assert all(o[0] == 'w' for o in ops.values())   # first touch writes
+    written = {p for p, o in ops.items() if 'w' in o[1:]}
+    assert abs(len(written) / pages - 0.25) < 0.05
+    # the same pages every time: a written page is always written, the
+    # others are always read
+    for p, o in ops.items():
+        assert set(o[1:]) == ({'w'} if p in written else {'r'})
+
+
+def test_unmapped_pages_are_skipped_and_remap_writes_again(tmp_path):
+    pages = 64
+    size = pages * PAGE
+    body = [region(0, size), ev('map', 0, 0, 0, size), ev('unmap', 100, 0, 0, size),
+            ev('map', 200, 0, 0, size)] + \
+        epochs(0, 300, 100, [access(0, 0, size, 40, write=0)])
+    log, p = run_logged(tmp_path, body, 'touches')
+    tt = touches(log)
+    before = [x for x in tt if x[0] < 100 * MS]
+    gap = [x for x in tt if 100 * MS <= x[0] < 200 * MS]
+    after = [x for x in tt if x[0] >= 200 * MS]
+    assert before and gap and after
+    assert all(op != 'skip' for *_, op in before)
+    assert all(op == 'skip' for *_, op in gap)
+    assert all(op != 'skip' for *_, op in after)
+    first = {}
+    for _, _, pg, op in after:
+        first.setdefault(pg, op)
+    assert set(first.values()) == {'w'}
+    assert lines(log, 'end')[0]['skipped'] == str(len(gap))
+
+
+# ---------------------------------------------------------------- overload
+
+
+def test_dropped_work_is_not_done_later(tmp_path):
+    size = 64 * MB
+    body = [region(0, size), ev('map', 0, 0, 0, size)] + \
+        epochs(0, 300, 100, [access(0, 0, size, 20000)])
+    log, _ = run_logged(tmp_path, body, 'ticks')
+    drops = [(int(d['tick']), int(d['skipped'])) for d in lines(log, 'drop')]
+    assert drops
+    skipped = set()
+    for t, k in drops:
+        skipped.update(range(t + 1, t + 1 + k))
+    tk = ticks(log)
+    assert not skipped & {t['tick'] for t in tk}     # no work in a skipped tick
+    assert any(t['done'] < t['n'] for t in tk)       # the late tick stopped short
+    for e in lines(log, 'epoch', what='end'):
+        assert int(e['done']) < int(e['planned'])
+    end = lines(log, 'end')[0]
+    assert int(end['lagged_ticks']) >= len(drops)
